# Configurações do Servidor
PORT=3000
NODE_ENV=development

# Origens permitidas pelo CORS (frontend externo), separadas por vírgula.
# Inclua a URL exata usada pelo Live Server.
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500

# MongoDB
# Atlas: mongodb+srv://usuario:senha@cluster.mongodb.net/psi
# Local: mongodb://127.0.0.1:27017/psi
MONGODB_URI=mongodb://127.0.0.1:27017/psi

# Autenticação JWT
JWT_SECRET=troque-por-um-segredo-forte
